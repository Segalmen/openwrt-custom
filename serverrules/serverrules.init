#!/bin/sh /etc/rc.common
# serverrules — block remote server ranges (openwrt-custom)

START=95
USE_PROCD=1

SCRIPT="/usr/libexec/serverrules/serverrules.sh"
NFT="/usr/sbin/nft"

start_service() {
    $SCRIPT
}

stop_service() {
    $NFT delete table inet serverrules 2>/dev/null
}

reload_service() {
    $SCRIPT
}

service_triggers() {
    procd_add_reload_trigger serverrules
}
