#!/usr/bin/env lua
-- =============================================================================
-- luci.dscp — rpcd backend for the SQM QoS DSCP views
-- (connections, server history, labels, captures)
-- Reads active connections from /proc/net/nf_conntrack (read-only).
-- Writes only on explicit UI actions: conntrack flush, server history,
-- serverrules labels, tcpdump captures in /tmp/dscp-captures.
--
-- SPDX-License-Identifier: GPL-3.0-or-later
-- Derived from the luci.qosmate rpcd backend of luci-app-qosmate by hudra0
-- (https://github.com/hudra0/luci-app-qosmate, GPL-3.0-or-later),
-- modified and extended by Segalmen for openwrt-custom.
-- =============================================================================

local jsonc = require "luci.jsonc"

-- Path to conntrack proc file
local CONNTRACK_PATH = "/proc/net/nf_conntrack"

-- =============================================================================
-- Parse a single conntrack line into a connection table
-- Returns nil if the line cannot be parsed
-- =============================================================================
local function parse_connection(line)
    local conn = {}

    -- Extract: layer3, layer4 number, protocol, timeout
    conn.layer3, conn.layer4, conn.protocol, conn.timeout =
        line:match("(%w+)%s+(%d+)%s+(%w+)%s+(%d+)")

    if not (conn.layer3 and conn.layer4 and conn.protocol and conn.timeout) then
        return nil
    end

    conn.timeout = tonumber(conn.timeout) or 0

    -- ICMP / ICMPv6 have no ports
    if conn.protocol == "icmp" or conn.protocol == "icmpv6" then
        conn.src, conn.dst, conn.type, conn.code, conn.id =
            line:match("src=(%S+)%s+dst=(%S+)%s+type=(%d+)%s+code=(%d+)%s+id=(%d+)")
        conn.in_packets,  conn.in_bytes  = line:match("packets=(%d+)%s+bytes=(%d+)")
        conn.out_packets, conn.out_bytes = conn.in_packets, conn.in_bytes
        conn.sport = "-"
        conn.dport = "-"
    else
        -- TCP / UDP and others: two directions in the line
        local src1, dst1, sport1, dport1, pkt1, bytes1,
              src2, dst2, sport2, dport2, pkt2, bytes2 =
            line:match(
                "src=(%S+)%s+dst=(%S+)%s+sport=(%d+)%s+dport=(%d+)%s+packets=(%d+)%s+bytes=(%d+)" ..
                ".*src=(%S+)%s+dst=(%S+)%s+sport=(%d+)%s+dport=(%d+)%s+packets=(%d+)%s+bytes=(%d+)"
            )

        if not (src1 and dst1) then
            return nil
        end

        -- Always use first direction as original (outbound from LAN perspective)
        conn.src   = src1
        conn.dst   = dst1
        conn.sport = sport1
        conn.dport = dport1
        conn.out_packets = tonumber(pkt1)   or 0
        conn.in_packets  = tonumber(pkt2)   or 0
        conn.out_bytes   = tonumber(bytes1) or 0
        conn.in_bytes    = tonumber(bytes2) or 0
    end

    if not (conn.src and conn.dst) then
        return nil
    end

    -- DSCP: stored in conntrack mark bits [5:0] (lower 6 bits)
    -- Bit 7 (0x80) is the "valid" flag set by our nftables rules
    local raw_mark = tonumber(line:match("mark=(%d+)") or "0") or 0
    -- Only report DSCP when the valid flag is set. Marks set by anything else
    -- (mwan3, custom firewall rules) would otherwise be read as a DSCP class
    -- and shown as one. The kernel applies the same rule on ingress:
    -- `action ctinfo dscp 63 128` restores nothing without bit 0x80.
    if math.floor(raw_mark / 128) % 2 ~= 0 then
        conn.dscp = raw_mark % 64
    else
        conn.dscp = 0
    end

    conn.use = tonumber(line:match("use=(%d+)") or "0") or 0

    -- Connection state
    if line:match("%[ASSURED%]") then
        conn.state = "ASSURED"
    elseif line:match("%[UNREPLIED%]") then
        conn.state = "UNREPLIED"
    else
        conn.state = "SEEN_REPLY"
    end

    return conn
end

-- =============================================================================
-- Read and parse all connections from nf_conntrack
-- Returns a table keyed by connection 5-tuple
-- =============================================================================
local function get_connections()
    local connections = {}

    local f = io.open(CONNTRACK_PATH, "r")
    if not f then
        -- conntrack module not loaded or not available
        return connections
    end

    for line in f:lines() do
        local conn = parse_connection(line)
        if conn then
            -- Key = unique 5-tuple to deduplicate
            local key = string.format(
                "%s:%s:%s:%s:%s:%s",
                conn.layer3,
                conn.protocol,
                conn.src,
                conn.sport or "-",
                conn.dst,
                conn.dport or "-"
            )
            connections[key] = conn
        end
    end
    f:close()

    return connections
end

-- =============================================================================
-- Flush conntrack entries for a given IP (IPv4 or IPv6)
-- Returns count of flushed entries by parsing conntrack output
-- =============================================================================
local function flush_ip(ip, family_flag)
    if not ip or ip == "" then
        return 0
    end

    local total = 0

    -- Flush both directions: source and destination
    for _, direction in ipairs({ "-s", "-d" }) do
        -- Redirect stderr to stdout to capture the "X flow entries deleted" message
        local cmd = string.format("conntrack -D %s %s %s 2>&1",
            direction, ip, family_flag or "")

        local handle = io.popen(cmd)
        if handle then
            local output = handle:read("*a") or ""
            handle:close()

            -- Parse: "conntrack v1.4.8 (conntrack-tools): N flow entries have been deleted."
            local count = output:match("(%d+)%s+flow%s+entries%s+have%s+been%s+deleted")
            if count then
                total = total + tonumber(count)
            end
        end
    end

    return total
end

local uci = require "luci.model.uci"

local function run_cmd(cmd)
    local handle = io.popen(cmd .. " 2>&1")
    if not handle then return "" end
    local output = handle:read("*a") or ""
    handle:close()
    return output
end

-- =============================================================================
-- RPC method definitions
-- =============================================================================
local methods = {
    getConntrackDSCP = {
        args = {},
        call = function()
            local ok, connections = pcall(get_connections)
            if not ok then
                -- Return empty result on error rather than crashing rpcd
                return { result = jsonc.stringify({ connections = {} }) }
            end
            return { result = jsonc.stringify({ connections = connections }) }
        end
    },

    flushConntrack = {
        args = { ip4 = "", ip6 = "" },
        call = function(args)
            args = args or {}
            local ip4 = args.ip4 or ""
            local ip6 = args.ip6 or ""

            -- Accept a comma/space separated list (sqm priority_ip may hold
            -- several devices). Each token is validated on its own.
            -- Basic safety: only accept IPv4/IPv6-looking patterns
            -- Reject anything with shell metacharacters to prevent injection
            -- Reject overly broad CIDR masks to prevent mass-flush of conntrack
            -- (e.g. 0.0.0.0/0 would wipe the entire conntrack table)
            local function safe_ip(s)
                if type(s) ~= "string" then return "" end
                -- Allow digits, dots, colons, slash (for CIDR), letters a-f (IPv6 hex)
                if not s:match("^[%da-fA-F%.%:%/]+$") then
                    return ""
                end
                -- If CIDR notation present, enforce minimum mask per family
                -- Thresholds match "one LAN segment" — IPv4 /24, IPv6 /64
                local mask = s:match("/(%d+)$")
                if mask then
                    local mask_n = tonumber(mask) or -1
                    if s:find(":", 1, true) then
                        -- IPv6: require /64 or stricter
                        if mask_n < 64 or mask_n > 128 then return "" end
                    else
                        -- IPv4: require /24 or stricter
                        if mask_n < 24 or mask_n > 32 then return "" end
                    end
                end
                return s
            end

            local function flush_list(list, fam)
                local count, done = 0, {}
                for tok in tostring(list):gmatch("[^,%s]+") do
                    local ip = safe_ip(tok)
                    if ip ~= "" then
                        count = count + flush_ip(ip, fam)
                        done[#done + 1] = ip
                    end
                end
                return count, table.concat(done, ",")
            end

            local ipv4_count, ipv6_count
            ipv4_count, ip4 = flush_list(ip4, "-f ipv4")
            ipv6_count, ip6 = flush_list(ip6, "-f ipv6")

            local total = ipv4_count + ipv6_count

            return {
                result = jsonc.stringify({
                    success    = true,
                    ipv4       = ip4,
                    ipv6       = ip6,
                    ipv4_count = ipv4_count,
                    ipv6_count = ipv6_count,
                    total      = total
                })
            }
        end
    },
    logServer = {
        args = { ip = "", port = "", region = "", dscp = "" },
        call = function(args)
            args = args or {}
            local ip = tostring(args.ip or "")
            -- validate IPv4/IPv6-ish: digits, dots, colons, hex only
            if not ip:match("^[%x%.:]+$") or #ip < 3 or #ip > 45 then
                return { result = jsonc.stringify({ success = false, error = "invalid ip" }) }
            end
            -- sanitize the other fields (strip anything not safe)
            local function clean(s, maxlen)
                s = tostring(s or ""):gsub("[^%w%._%- ]", "")
                if #s > maxlen then s = s:sub(1, maxlen) end
                return s
            end
            local entry = {
                ts     = os.time(),
                ip     = ip,
                port   = clean(args.port, 8),
                region = clean(args.region, 40),
                dscp   = clean(args.dscp, 8)
            }

            os.execute("mkdir -p /etc/sqm-dscp")
            local path = "/etc/sqm-dscp/server-history.jsonl"
            local fh = io.open(path, "a")
            if not fh then
                return { result = jsonc.stringify({ success = false, error = "cannot open log" }) }
            end
            fh:write(jsonc.stringify(entry) .. "\n")
            fh:close()
            return { result = jsonc.stringify({ success = true, entry = entry }) }
        end
    },

    getServerHistory = {
        args = {},
        call = function()
            local path = "/etc/sqm-dscp/server-history.jsonl"
            local entries = {}
            local fh = io.open(path, "r")
            if fh then
                for line in fh:lines() do
                    if line and line ~= "" then
                        local obj = jsonc.parse(line)
                        if obj then entries[#entries + 1] = obj end
                    end
                end
                fh:close()
            end
            return { result = jsonc.stringify({ success = true, entries = entries }) }
        end
    },

    clearServerHistory = {
        args = {},
        call = function()
            local path = "/etc/sqm-dscp/server-history.jsonl"
            os.remove(path)
            return { result = jsonc.stringify({ success = true }) }
        end
    },

    -- -------------------------------------------------------------------------
    -- labelServer: create (or extend) a serverrules rule.
    -- A NEW rule is created with enabled='0' (label only, no firewall
    -- effect). An EXISTING rule of that name is extended as it is: when it
    -- is active, the added range is blocked. Single write path shared by the
    -- 🏷️ Label buttons in Connections and Server History. suggestCidr only
    -- feeds the caller with a CIDR; the write stays here.
    -- -------------------------------------------------------------------------
    labelServer = {
        args = { name = "", cidr = "" },
        call = function(args)
            args = args or {}
            local name = tostring(args.name or "")
            local cidr = tostring(args.cidr or "")

            -- name: letters/digits/underscore only (matches existing convention)
            if not name:match("^[%w_]+$") then
                return { result = jsonc.stringify({ success = false, error = "invalid name (letters, digits, _)" }) }
            end
            -- cidr: IPv4/CIDR shape, octets <= 255, prefix /8 to /32
            local o1, o2, o3, o4, pfx = cidr:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)/(%d+)$")
            o1, o2, o3, o4, pfx = tonumber(o1), tonumber(o2), tonumber(o3), tonumber(o4), tonumber(pfx)
            if not o1 or o1 > 255 or o2 > 255 or o3 > 255 or o4 > 255 or pfx > 32 then
                return { result = jsonc.stringify({ success = false, error = "invalid cidr" }) }
            end
            if pfx < 8 then
                return { result = jsonc.stringify({ success = false, error = "invalid cidr: prefix shorter than /8 (range too wide)" }) }
            end
            -- Refuse private/reserved ranges (self-ban protection). Same
            -- families as the UI guards and serverrules.sh; no bitwise ops.
            if o1 == 10 or o1 == 127 or o1 == 0 or o1 >= 224
               or (o1 == 172 and o2 >= 16 and o2 <= 31)
               or (o1 == 192 and o2 == 168)
               or (o1 == 169 and o2 == 254) then
                return { result = jsonc.stringify({ success = false, error = "private/reserved range refused" }) }
            end

            local x = uci.cursor()
            if not x then
                return { result = jsonc.stringify({ success = false, error = "uci unavailable" }) }
            end

            -- find an existing rule with this name
            local target_sid = nil
            x:foreach("serverrules", "rule", function(s)
                if (s.name or "") == name then target_sid = s[".name"] end
            end)

            local created = false
            if target_sid then
                -- extend: append cidr if not already present
                local ranges = x:get("serverrules", target_sid, "range") or {}
                if type(ranges) ~= "table" then ranges = { ranges } end
                for _, r in ipairs(ranges) do
                    if r == cidr then
                        return { result = jsonc.stringify({ success = false, error = "cidr already in rule" }) }
                    end
                end
                table.insert(ranges, cidr)
                x:set("serverrules", target_sid, "range", ranges)
            else
                -- create a new label rule, disabled (label only)
                target_sid = x:add("serverrules", "rule")
                x:set("serverrules", target_sid, "name", name)
                x:set("serverrules", target_sid, "enabled", "0")
                x:set("serverrules", target_sid, "range", { cidr })
                created = true
            end

            x:commit("serverrules")
            return { result = jsonc.stringify({
                success = true, created = created, name = name, cidr = cidr
            }) }
        end
    },

    -- -------------------------------------------------------------------------
    -- suggestCidr: propose a CIDR for an IP, WITHOUT any
    -- external API (read-only, no network dependency). Strategy:
    --   1. if the IP falls inside the /16 of a range already known in a
    --      serverrules rule, suggest extending THAT rule (reuses the user's
    --      accumulated knowledge, e.g. Frankfurt 34.185.x → 34.179.x)
    --   2. otherwise suggest <ip>/24 as the precise default, plus a wider
    --      <ip>/16 variant the UI can offer as "broaden"
    -- The result is only a suggestion; the user always edits/validates UI-side.
    -- args: { ip = "34.159.57.168" }
    -- -------------------------------------------------------------------------
    suggestCidr = {
        args = { ip = "" },
        call = function(args)
            args = args or {}
            local ip = tostring(args.ip or "")
            -- IPv4 only for suggestion (CIDR math); reject anything else
            local o1, o2, o3, o4 = ip:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
            if not o1 then
                return { result = jsonc.stringify({ success = false, error = "ipv4 only" }) }
            end
            o1, o2, o3, o4 = tonumber(o1), tonumber(o2), tonumber(o3), tonumber(o4)
            if o1 > 255 or o2 > 255 or o3 > 255 or o4 > 255 then
                return { result = jsonc.stringify({ success = false, error = "invalid ipv4" }) }
            end

            local ipnum = o1 * 16777216 + o2 * 65536 + o3 * 256 + o4

            -- helper: is ipnum inside cidr base a.b.c.d/p ?
            -- No bitwise ops (router lua is not 5.3): two addresses share a /p
            -- iff floor(addr / blocksize) is equal, with blocksize = 2^(32-p).
            local function in_cidr(a, b, c, d, p)
                if p < 0 or p > 32 then return false end
                local base = a * 16777216 + b * 65536 + c * 256 + d
                local blocksize = 2 ^ (32 - p)
                return math.floor(ipnum / blocksize) == math.floor(base / blocksize)
            end

            -- 0. REAL BGP prefix via RIPEstat (the true, exact announced prefix).
            -- uclient-fetch is in OpenWrt base; HTTPS needs libustream + ca-bundle
            -- (install.sh pulls them). Short timeout, never blocking: on any
            -- failure we fall back to the local heuristic below.
            local bgp_prefix = nil
            local bgp_asn = nil
            local url = "https://stat.ripe.net/data/network-info/data.json?resource=" .. ip
            local cmd = "uclient-fetch -qO- -T 4 '" .. url .. "' 2>/dev/null"
            local resp = run_cmd(cmd)
            if resp and #resp > 0 then
                -- minimal extraction (no json dep needed): "prefix":"a.b.c.d/p"
                local pfx = resp:match('"prefix"%s*:%s*"([%d%.]+/%d+)"')
                if pfx and pfx:match("^%d+%.%d+%.%d+%.%d+/%d+$") then
                    bgp_prefix = pfx
                end
                bgp_asn = resp:match('"asns"%s*:%s*%[%s*"(%d+)"')
            end

            -- 1. scan existing serverrules rules for a covering/neighbouring range
            local x = uci.cursor()
            local suggestion = nil
            if x then
                x:foreach("serverrules", "rule", function(s)
                    if suggestion then return end
                    local ranges = s.range or {}
                    if type(ranges) ~= "table" then ranges = { ranges } end
                    for _, r in ipairs(ranges) do
                        local a, b, c, d, p = r:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)/(%d+)$")
                        if a then
                            a, b, c, d, p = tonumber(a), tonumber(b), tonumber(c), tonumber(d), tonumber(p)
                            -- already covered by this exact range?
                            if in_cidr(a, b, c, d, p) then
                                suggestion = { cidr = r, rule = (s.name or ""), reason = "covered" }
                                return
                            end
                            -- same /16 neighbourhood → note the rule for "extend" hint
                            if a == o1 and b == o2 then
                                suggestion = { cidr = string.format("%d.%d.0.0/16", o1, o2),
                                               rule = (s.name or ""), reason = "neighbour" }
                                return
                            end
                        end
                    end
                end)
            end

            local default24 = string.format("%d.%d.%d.0/24", o1, o2, o3)
            local wide16    = string.format("%d.%d.0.0/16", o1, o2)

            -- Decision: the REAL BGP prefix wins (the true & exact range).
            -- If an existing rule already covers the IP, keep the "extend that
            -- rule" hint. Otherwise BGP prefix, else neighbour heuristic, else /24.
            local final_cidr, final_reason, final_rule
            if suggestion and suggestion.reason == "covered" then
                final_cidr, final_reason, final_rule = suggestion.cidr, "covered", suggestion.rule
            elseif bgp_prefix then
                final_cidr, final_reason, final_rule = bgp_prefix, "bgp", (suggestion and suggestion.rule or "")
            elseif suggestion then
                final_cidr, final_reason, final_rule = suggestion.cidr, suggestion.reason, suggestion.rule
            else
                final_cidr, final_reason, final_rule = default24, "default", ""
            end

            return { result = jsonc.stringify({
                success    = true,
                ip         = ip,
                suggested  = final_cidr,
                rule       = final_rule,
                reason     = final_reason,
                bgp_prefix = bgp_prefix or "",
                asn        = bgp_asn or "",
                default24  = default24,
                wide16     = wide16
            }) }
        end
    },

    -- -------------------------------------------------------------------------
    -- packet capture (tcpdump) for diagnostics.
    -- Captures stay in /tmp/dscp-captures (RAM, NOT under /www, so never
    -- served unauthenticated). Download goes through cgi-io (authenticated).
    -- Hard guards: single capture at a time (lock), duration cap, size cap,
    -- strictly validated BPF (host + optional ports only — no shell metachars).
    -- args: { iface, ip, ports (csv, optional), duration }
    -- -------------------------------------------------------------------------
    startCapture = {
        args = { iface = "", ip = "", ports = "", duration = 120, label = "" },
        call = function(args)
            args = args or {}
            local DIR = "/tmp/dscp-captures"
            os.execute("mkdir -p " .. DIR)

            -- validate iface FIRST (needed for the per-interface lock)
            local iface = tostring(args.iface or "br-lan")
            if not iface:match("^[%w%.%-]+$") then
                return { result = jsonc.stringify({ success = false, error = "invalid iface" }) }
            end

            -- Per-interface lock: 1 live capture per iface (so eth3 + br-lan can
            -- run in parallel to compare before/after NAT), but no duplicate on
            -- the same iface. Global cap of 4 live captures protects RAM (/tmp).
            local LOCK = DIR .. "/.lock-" .. iface
            local live = 0
            local lsout = run_cmd("ls -1 " .. DIR .. "/.lock-* 2>/dev/null")
            for lp in lsout:gmatch("[^\r\n]+") do
                local f = io.open(lp, "r")
                if f then
                    local pid = (f:read("*a") or ""):gsub("%s", ""); f:close()
                    if pid ~= "" and os.execute("kill -0 " .. pid .. " 2>/dev/null") == 0 then
                        live = live + 1
                        if lp == LOCK then
                            return { result = jsonc.stringify({ success = false,
                                error = "a capture is already running on " .. iface }) }
                        end
                    else
                        os.remove(lp)  -- stale lock, clean it
                    end
                end
            end
            if live >= 4 then
                return { result = jsonc.stringify({ success = false,
                    error = "too many captures running (max 4); wait or delete one" }) }
            end

            -- ip is OPTIONAL: the remote server is often picked dynamically, so
            -- the "ports" capture filters by PORT, not by host. host filter is
            -- only used when an ip is explicitly given (e.g. a known server).
            local ip = tostring(args.ip or "")
            if ip ~= "" and (not ip:match("^[%x%.:]+$") or #ip < 3) then
                return { result = jsonc.stringify({ success = false, error = "invalid ip" }) }
            end
            -- validate ports: only digits, commas and dashes (csv/ranges)
            local ports = tostring(args.ports or "")
            if ports ~= "" and not ports:match("^[%d,%-]+$") then
                return { result = jsonc.stringify({ success = false, error = "invalid ports" }) }
            end
            -- must have at least one selector (port or ip), else refuse
            if ip == "" and ports == "" then
                return { result = jsonc.stringify({ success = false, error = "need a port or an ip to capture" }) }
            end
            -- duration: clamp 1..300
            local dur = tonumber(args.duration) or 120
            if dur < 1 then dur = 1 end
            if dur > 300 then dur = 300 end

            -- build a SAFE BPF. Port-based by default (robust to matchmaking:
            -- the server IP is unknown in advance). Optional host narrows it.
            local parts = {}
            if ip ~= "" then parts[#parts + 1] = "host " .. ip end
            if ports ~= "" then
                local pexpr = {}
                for p in ports:gmatch("[^,]+") do
                    if p:match("^%d+%-%d+$") then
                        pexpr[#pexpr + 1] = "portrange " .. p
                    elseif p:match("^%d+$") then
                        pexpr[#pexpr + 1] = "port " .. p
                    end
                end
                if #pexpr > 0 then
                    parts[#parts + 1] = "(" .. table.concat(pexpr, " or ") .. ")"
                end
            end
            local bpf = table.concat(parts, " and ")

            -- optional label: an indicative server IP shown at click time in
            -- ports mode. It only feeds the FILENAME, never the BPF (the actual
            -- server may differ). Validated like an IP.
            local label = tostring(args.label or "")
            if label ~= "" and not label:match("^[%x%.:]+$") then label = "" end

            local ts    = os.time()
            local itag  = iface:gsub("[^%w]", "_")
            local ftag
            if ip ~= "" then
                ftag = ip:gsub("[^%w]", "_")
            elseif label ~= "" then
                ftag = label:gsub("[^%w]", "_") .. "-p" .. (ports:gsub("[^%w]", "_"))
            else
                ftag = "p" .. (ports:gsub("[^%w]", "_"))
            end
            local fname = string.format("capture-%s-%s-%d.pcap", itag, ftag, ts)
            local fpath = DIR .. "/" .. fname

            -- Duration bound WITHOUT `timeout` (absent) and WITHOUT relying on
            -- tcpdump -G (which only rotates when a packet arrives, so a quiet
            -- filtered flow would run forever). We launch tcpdump in the
            -- background, record its PID, and a detached watchdog kills it
            -- after <dur> seconds. -c is a hard packet-count safety net.
            -- The BPF is single-quoted: its parentheses must reach tcpdump,
            -- not be parsed by the shell (which would be a syntax error).
            local cmd = string.format(
                "tcpdump -i %s -c 200000 -w %s '%s' >/dev/null 2>&1 & "
                .. "TPID=$!; echo $TPID > %s; "
                .. "( sleep %d; kill $TPID 2>/dev/null; rm -f %s ) >/dev/null 2>&1 &",
                iface, fpath, bpf, LOCK, dur, LOCK)
            os.execute(cmd)

            return { result = jsonc.stringify({
                success = true, file = fname, duration = dur, bpf = bpf
            }) }
        end
    },

    listCaptures = {
        args = {},
        call = function()
            local DIR = "/tmp/dscp-captures"
            -- use find (clean output, no error line when empty)
            local out = run_cmd("find " .. DIR .. " -maxdepth 1 -name '*.pcap*' -type f 2>/dev/null")
            local files = {}
            for path in out:gmatch("[^\r\n]+") do
                local name = path:match("([^/]+)$")
                if name and name:match("%.pcap") then
                    local sz = run_cmd("wc -c < '" .. path .. "' 2>/dev/null"):gsub("%s", "")
                    files[#files + 1] = {
                        name = name, path = path, size = tonumber(sz) or 0
                    }
                end
            end
            -- count live per-interface captures (.lock-<iface>)
            local running = 0
            local lsout = run_cmd("ls -1 " .. DIR .. "/.lock-* 2>/dev/null")
            for lp in lsout:gmatch("[^\r\n]+") do
                local lf = io.open(lp, "r")
                if lf then
                    local pid = (lf:read("*a") or ""):gsub("%s", ""); lf:close()
                    if pid ~= "" and os.execute("kill -0 " .. pid .. " 2>/dev/null") == 0 then
                        running = running + 1
                    end
                end
            end
            return { result = jsonc.stringify({ success = true, files = files, running = running }) }
        end
    },

    deleteCapture = {
        args = { name = "" },
        call = function(args)
            args = args or {}
            local name = tostring(args.name or "")
            -- only allow plain capture file names, no path traversal
            if not name:match("^capture%-[%w_%.%-]+%.pcap%d*$") then
                return { result = jsonc.stringify({ success = false, error = "invalid name" }) }
            end
            os.remove("/tmp/dscp-captures/" .. name)
            return { result = jsonc.stringify({ success = true }) }
        end
    },

    -- list real network interfaces for the capture selector.
    -- Read-only. Tags br-lan / WAN so the UI can hint which to pick:
    -- br-lan = flow/IP view (DSCP not yet marked on egress);
    -- WAN    = on-the-wire DSCP after nftables marking.
    listInterfaces = {
        args = {},
        call = function()
            -- resolve the WAN L3 device from the network config (best effort)
            local wan = run_cmd(". /lib/functions/network.sh 2>/dev/null; "
                .. "network_get_device dev wan 2>/dev/null; echo $dev"):gsub("%s", "")
            local out = run_cmd("ls -1 /sys/class/net 2>/dev/null")
            local ifaces = {}
            for name in out:gmatch("[^\r\n]+") do
                if name ~= "lo" and not name:match("^ifb") then
                    local role = ""
                    if name == "br-lan" then role = "lan"
                    elseif wan ~= "" and name == wan then role = "wan" end
                    ifaces[#ifaces + 1] = { name = name, role = role }
                end
            end
            return { result = jsonc.stringify({ success = true, interfaces = ifaces, wan = wan }) }
        end
    }
}

-- =============================================================================
-- rpcd dispatch
-- =============================================================================
if arg[1] == "list" then
    local rv = {}
    for name, def in pairs(methods) do
        rv[name] = def.args or {}
    end
    -- rpcd expects "{}" not "[]" for empty arg tables
    print((jsonc.stringify(rv):gsub(":%[%]", ":{}")))

elseif arg[1] == "call" then
    local method = methods[arg[2]]
    if method then
        local input = io.stdin:read("*a")
        local args = {}
        if input and input ~= "" then
            args = jsonc.parse(input) or {}
        end
        local result = method.call(args)
        print(result.result)
        os.exit(result.code or 0)
    else
        print(jsonc.stringify({ error = "Method not found: " .. tostring(arg[2]) }))
        os.exit(1)
    end
else
    -- Called without arguments — print usage hint to stderr
    io.stderr:write("Usage: luci.dscp list | call <method>\n")
    os.exit(1)
end
