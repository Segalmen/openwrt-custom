#!/bin/sh
# =============================================================================
# Seg_Layer_Cake.qos — Custom SQM script for OpenWrt
# Based on layer_cake.qos / Cero3
# - QDISC    : CAKE (with optional multi-queue via cake_mq)
# - Egress   : DSCP marking via nftables (postrouting ON / prerouting OFF)
# - Ingress  :
#     ctinfo ON  → postrouting marks + store ctmark → tc ctinfo restores DSCP
#     ctinfo OFF → tc simple redirect; download is NOT classified
#                  (tc ingress / IFB runs before netfilter prerouting)
#
# Pipeline ctinfo ON (recommended, any topology incl. double NAT):
#   postrouting (mark + store ctmark) → tc ctinfo restore → CAKE diffserv
#
# Pipeline ctinfo OFF (upload classification only):
#   prerouting (mark upload) + postrouting (store ctmark only) → CAKE
# =============================================================================

[ "${SQM_DEBUG_XTRACE:-0}" = "1" ] && set -x

. ${SQM_LIB_DIR}/defaults.sh
QDISC=cake

# =============================================================================
# Helpers
# =============================================================================

# Safe UCI getter with explicit default
# Usage: uci_get <section> <option> <default>
uci_get() {
    local _section="$1"
    local _option="$2"
    local _default="$3"
    local _val
    _val="$(uci -q get "${_section}.${_option}" 2>/dev/null)"
    if [ -z "$_val" ]; then
        echo "$_default"
    else
        echo "$_val"
    fi
}

# Normalize a comma-separated IP list to nftables set syntax: { a, b, c }
make_nft_set() {
    local _raw="$1"
    local _clean
    _clean="$(printf '%s' "$_raw" | sed 's/,/ , /g; s/  */ /g; s/^ //; s/ $//')"
    printf '{ %s }' "$_clean"
}

# Convert DSCP name to conntrack mark value (with 0x80 valid flag)
#
# RESERVED for future use — intentionally unused, do not remove.
#
# The script currently stores DSCP→ctmark directly in nftables via
# `ct mark set ip dscp | 0x80` (see setup_nftables()) in both ctinfo
# modes. This helper is kept for:
#   - Future extensions that may need fixed ctmarks from shell
#     (e.g. per-rule pre-computed ctmark instead of runtime bitwise OR)
#   - Portability on older kernels/nftables where bitwise OR on ip dscp
#     could behave differently (kernel 3.14+ behaves correctly)
#
# Usage: ctmark=$(dscp_to_ctmark "cs4")  # returns "0xa0"
dscp_to_ctmark() {
    case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
        cs0)  echo "0x80" ;;
        cs1)  echo "0x88" ;;
        cs2)  echo "0x90" ;;
        cs3)  echo "0x98" ;;
        cs4)  echo "0xa0" ;;
        cs5)  echo "0xa8" ;;
        cs6)  echo "0xb0" ;;
        cs7)  echo "0xb8" ;;
        ef)   echo "0xae" ;;
        va)   echo "0xac" ;;
        le|lephb) echo "0x81" ;;
        af11) echo "0x8a" ;;
        af12) echo "0x8c" ;;
        af13) echo "0x8e" ;;
        af21) echo "0x92" ;;
        af22) echo "0x94" ;;
        af23) echo "0x96" ;;
        af31) echo "0x9a" ;;
        af32) echo "0x9c" ;;
        af33) echo "0x9e" ;;
        af41) echo "0xa2" ;;
        af42) echo "0xa4" ;;
        af43) echo "0xa6" ;;
        *) return 1 ;;
    esac
}

# Return $1 if it is a DSCP class the project knows, else $2 and log why.
# $3 is the UCI option name, for the log line only.
validate_dscp() {
    if dscp_to_ctmark "$1" >/dev/null 2>&1; then
        printf '%s' "$1"
    else
        logger -t SQM "Seg_Layer_Cake.qos: invalid $3 '$1' — falling back to '$2'"
        printf '%s' "$2"
    fi
}

# =============================================================================
# SQM section detection — bound to $IFACE
# =============================================================================
detect_sqm_section() {
    local _sec _iface_re
    _iface_re="$(printf '%s' "$IFACE" | sed 's/\./\\./g')"
    _sec="$(uci -q show sqm 2>/dev/null \
        | sed -n "s/^\(sqm\.[^.]*\)\.interface='${_iface_re}'$/\1/p" \
        | head -n1)"
    [ -z "$_sec" ] && _sec="sqm.@queue[0]"
    echo "$_sec"
}

SQM_SECTION="$(detect_sqm_section)"

# =============================================================================
# Load all UCI options — exported for sub-functions
# =============================================================================
_load_uci_options() {
    ENABLE_MQ="$(uci_get "$SQM_SECTION" enable_mq 0)"
    CTINFO_ENABLE="$(uci_get "$SQM_SECTION" ctinfo_enable 1)"

    PRIORITY_IP_RAW="$(uci_get "$SQM_SECTION" priority_ip '')"
    PRIORITY_IP6_RAW="$(uci_get "$SQM_SECTION" priority_ip6 '')"

    PRIORITY_UDP_ENABLE="$(uci_get "$SQM_SECTION" priority_udp_enable 0)"
    PRIORITY_UDP_DSCP="$(uci_get "$SQM_SECTION" priority_udp_dscp ef)"
    PRIORITY_UDP_PORTS="$(uci_get "$SQM_SECTION" priority_udp_ports '')"

    PRIORITY_TCP_ENABLE="$(uci_get "$SQM_SECTION" priority_tcp_enable 0)"
    PRIORITY_TCP_DSCP="$(uci_get "$SQM_SECTION" priority_tcp_dscp cs0)"
    PRIORITY_TCP_PORTS="$(uci_get "$SQM_SECTION" priority_tcp_ports '')"

    BROWSING_ENABLE="$(uci_get "$SQM_SECTION" browsing_enable 0)"
    BROWSING_DSCP="$(uci_get "$SQM_SECTION" browsing_dscp af21)"
    BROWSING_TCP_PORTS="$(uci_get "$SQM_SECTION" browsing_tcp_ports '80,8080,443')"
    BROWSING_UDP_PORTS="$(uci_get "$SQM_SECTION" browsing_udp_ports '443')"

    BULK_ENABLE="$(uci_get "$SQM_SECTION" bulk_enable 0)"
    # Bulk has its own port lists. Unset falls back to the browsing lists,
    # which is what installs made before v1.8.0 relied on.
    BULK_TCP_PORTS="$(uci_get "$SQM_SECTION" bulk_tcp_ports "$BROWSING_TCP_PORTS")"
    BULK_UDP_PORTS="$(uci_get "$SQM_SECTION" bulk_udp_ports "$BROWSING_UDP_PORTS")"
    BULK_DSCP="$(uci_get "$SQM_SECTION" bulk_dscp cs1)"

    # Big HTTPS auto-downgrade
    BIG_HTTPS_DOWNGRADE="$(uci_get "$SQM_SECTION" big_https_downgrade 1)"

    # Size tiers on priority traffic (2.0.0, off by default): small packets
    # keep the priority class, medium ones get PRIORITY_MEDIUM_DSCP, large
    # ones are demoted to the bulk class.
    PRIORITY_SIZE_TIERS="$(uci_get "$SQM_SECTION" priority_size_tiers 0)"
    PRIORITY_SIZE_SMALL="$(uci_get "$SQM_SECTION" priority_size_small 160)"
    PRIORITY_SIZE_MEDIUM="$(uci_get "$SQM_SECTION" priority_size_medium 1300)"
    PRIORITY_MEDIUM_DSCP="$(uci_get "$SQM_SECTION" priority_medium_dscp cs4)"

    # Network-wide services (2.0.0, all off by default). Each one only marks
    # traffic still at CS0, so a mark set by an application or by the
    # priority rules is never overwritten.
    SVC_ICMP_DSCP="$(uci_get "$SQM_SECTION" svc_icmp_dscp cs0)"
    SVC_DNS="$(uci_get "$SQM_SECTION" svc_dns 0)"
    SVC_SSH="$(uci_get "$SQM_SECTION" svc_ssh 0)"
    SVC_CONFERENCING="$(uci_get "$SQM_SECTION" svc_conferencing 0)"
    SVC_LIVE_VIDEO="$(uci_get "$SQM_SECTION" svc_live_video 0)"
    SVC_VOIP="$(uci_get "$SQM_SECTION" svc_voip 0)"

    # Normalize DSCP to lowercase (nftables requirement)
    PRIORITY_UDP_DSCP="$(printf '%s' "$PRIORITY_UDP_DSCP" | tr '[:upper:]' '[:lower:]')"
    PRIORITY_TCP_DSCP="$(printf '%s' "$PRIORITY_TCP_DSCP" | tr '[:upper:]' '[:lower:]')"
    BROWSING_DSCP="$(printf '%s'     "$BROWSING_DSCP"     | tr '[:upper:]' '[:lower:]')"
    BULK_DSCP="$(printf '%s'         "$BULK_DSCP"         | tr '[:upper:]' '[:lower:]')"

    # A DSCP set outside LuCI (uci set, restored config, hand-edited file) can
    # be anything. nftables would reject the rule and the whole policy would be
    # missing while SQM still reports success, so fall back to the default and
    # say so in the log. dscp_to_ctmark() knows every class the project uses.
    PRIORITY_UDP_DSCP="$(validate_dscp "$PRIORITY_UDP_DSCP" ef   priority_udp_dscp)"
    PRIORITY_TCP_DSCP="$(validate_dscp "$PRIORITY_TCP_DSCP" cs0  priority_tcp_dscp)"
    BROWSING_DSCP="$(validate_dscp     "$BROWSING_DSCP"     af21 browsing_dscp)"
    BULK_DSCP="$(validate_dscp         "$BULK_DSCP"         cs1  bulk_dscp)"
    PRIORITY_MEDIUM_DSCP="$(printf '%s' "$PRIORITY_MEDIUM_DSCP" | tr '[:upper:]' '[:lower:]')"
    PRIORITY_MEDIUM_DSCP="$(validate_dscp "$PRIORITY_MEDIUM_DSCP" cs4 priority_medium_dscp)"
    SVC_ICMP_DSCP="$(printf '%s' "$SVC_ICMP_DSCP" | tr '[:upper:]' '[:lower:]')"
    SVC_ICMP_DSCP="$(validate_dscp "$SVC_ICMP_DSCP" cs0 svc_icmp_dscp)"

    # Size thresholds: whole numbers, small < medium < 1500, else defaults
    case "$PRIORITY_SIZE_SMALL$PRIORITY_SIZE_MEDIUM" in
        *[!0-9]*|"") _sz_ok=0 ;;
        *) _sz_ok=1 ;;
    esac
    if [ "$_sz_ok" = "0" ] || [ "$PRIORITY_SIZE_SMALL" -lt 1 ] || \
       [ "$PRIORITY_SIZE_SMALL" -ge "$PRIORITY_SIZE_MEDIUM" ] || [ "$PRIORITY_SIZE_MEDIUM" -ge 1500 ]; then
        logger -t SQM "Seg_Layer_Cake.qos: invalid priority_size_small/medium '$PRIORITY_SIZE_SMALL/$PRIORITY_SIZE_MEDIUM' — falling back to 160/1300"
        PRIORITY_SIZE_SMALL=160; PRIORITY_SIZE_MEDIUM=1300
    fi

    # Build nftables IP sets
    # No address for a family: use an address no forwarded packet carries,
    # so the rules of that family stay valid and simply never match.
    if [ -n "$PRIORITY_IP_RAW" ]; then
        PRIORITY_IP_SET="$(make_nft_set "$PRIORITY_IP_RAW")"
    else
        PRIORITY_IP_SET="{ 0.0.0.0/32 }"
    fi
    if [ -n "$PRIORITY_IP6_RAW" ]; then
        PRIORITY_IP6_SET="$(make_nft_set "$PRIORITY_IP6_RAW")"
    else
        PRIORITY_IP6_SET="{ ::/128 }"
    fi

    # MQ support — required by select_cake / start-sqm
    [ "$ENABLE_MQ" = "1" ] && SUPPORT_MQ=1 || SUPPORT_MQ=0
    USE_MQ="$ENABLE_MQ"

    export ENABLE_MQ CTINFO_ENABLE USE_MQ SUPPORT_MQ
    export PRIORITY_IP_RAW PRIORITY_IP6_RAW PRIORITY_IP_SET PRIORITY_IP6_SET
    export PRIORITY_UDP_ENABLE PRIORITY_UDP_DSCP PRIORITY_UDP_PORTS
    export PRIORITY_TCP_ENABLE PRIORITY_TCP_DSCP PRIORITY_TCP_PORTS
    export BROWSING_ENABLE BROWSING_DSCP BROWSING_TCP_PORTS BROWSING_UDP_PORTS
    export BULK_ENABLE BULK_DSCP BULK_TCP_PORTS BULK_UDP_PORTS
    export BIG_HTTPS_DOWNGRADE
    export PRIORITY_SIZE_TIERS PRIORITY_SIZE_SMALL PRIORITY_SIZE_MEDIUM PRIORITY_MEDIUM_DSCP
    export SVC_ICMP_DSCP SVC_DNS SVC_SSH SVC_CONFERENCING SVC_LIVE_VIDEO SVC_VOIP
}

# =============================================================================
# egress() — Upload : LAN -> WAN on $IFACE
# =============================================================================
egress() {
    local qdisc
    qdisc="$(select_cake "$IFACE")"

    SILENT=1 $TC qdisc del dev "$IFACE" root 2>/dev/null || true

    $TC qdisc add dev "$IFACE" root \
        $(get_stab_string) "$qdisc" \
        bandwidth "${UPLINK}kbit" \
        $(get_cake_lla_string) \
        ${EGRESS_CAKE_OPTS} ${EQDISC_OPTS}
}

# =============================================================================
# ingress() — Download : WAN -> LAN via IFB $DEV
# =============================================================================
ingress() {
    local qdisc
    qdisc="$(select_cake "$DEV")"

    SILENT=1 $TC qdisc del dev "$IFACE" handle ffff: ingress 2>/dev/null || true
    $TC qdisc add dev "$IFACE" handle ffff: ingress

    SILENT=1 $TC qdisc del dev "$DEV" root 2>/dev/null || true

    # With ctinfo ON keep DSCP meaningful — disable besteffort/wash
    if [ "$CTINFO_ENABLE" = "1" ]; then
        IGNORE_DSCP_INGRESS=0
    fi

    if [ "${IGNORE_DSCP_INGRESS:-0}" -eq 1 ]; then
        case " $INGRESS_CAKE_OPTS " in
            *" besteffort "*) ;;
            *) INGRESS_CAKE_OPTS="$INGRESS_CAKE_OPTS besteffort" ;;
        esac
    fi

    if [ "${ZERO_DSCP_INGRESS:-0}" -eq 1 ]; then
        case " $INGRESS_CAKE_OPTS " in
            *" wash "*) ;;
            *) INGRESS_CAKE_OPTS="$INGRESS_CAKE_OPTS wash" ;;
        esac
    fi

    $IP link set dev "$DEV" up 2>/dev/null || true

    $TC qdisc add dev "$DEV" root \
        $(get_stab_string) "$qdisc" \
        bandwidth "${DOWNLINK}kbit" \
        $(get_cake_lla_string) \
        ${INGRESS_CAKE_OPTS} ${IQDISC_OPTS}

    $IP link set dev "$DEV" up

    if [ "$CTINFO_ENABLE" = "1" ]; then
        # ctinfo ON — kernel restores DSCP from ctmark efficiently
        $TC filter add dev "$IFACE" parent ffff: protocol all matchall \
            action ctinfo dscp 63 128 \
            mirred egress redirect dev "$DEV"
    else
        # ctinfo OFF — plain redirect: download reaches CAKE with the DSCP
        # it arrived with (tc ingress runs before nftables prerouting)
        $TC filter add dev "$IFACE" parent ffff: protocol all matchall \
            action mirred egress redirect dev "$DEV"
    fi
}

# =============================================================================
# _build_dscp_rules() — Build all DSCP classification rules
#
# $1 = chain name ("postrouting" or "prerouting")
#
# ctinfo ON  → called with "postrouting"
# ctinfo OFF → called with "prerouting"
#
# Order matters: each rule can overwrite previous DSCP marks unless a
# guard "dscp !=" is present:
#
#   1. Priority UDP  → explicit high-priority traffic
#   2. Priority TCP  → explicit high-priority traffic
#   3. Bulk (TCP/UDP + BigHTTPS) → background web/download traffic → CS1
#   4. Browsing → only marks pure CS0 traffic (other devices on LAN)
# =============================================================================
# _prio_tier <ip|ip6> <set> <udp|tcp> <ports> <length range> <dscp> <comment>
# One size tier for the priority devices, both directions, both ports
# (same four matches as rules 1 and 2). Uses $_chain of the caller.
_prio_tier() {
    [ -n "$2" ] || return 0
    nft add rule inet sqm_dscp "$_chain" $1 saddr "$2" $3 sport { "$4" } \
        meta length "$5" counter $1 dscp set "$6" comment "${7}up"
    nft add rule inet sqm_dscp "$_chain" $1 saddr "$2" $3 dport { "$4" } \
        meta length "$5" counter $1 dscp set "$6" comment "${7}upsrv"
    nft add rule inet sqm_dscp "$_chain" $1 daddr "$2" $3 dport { "$4" } \
        meta length "$5" counter $1 dscp set "$6" comment "${7}dwn"
    nft add rule inet sqm_dscp "$_chain" $1 daddr "$2" $3 sport { "$4" } \
        meta length "$5" counter $1 dscp set "$6" comment "${7}dwnsrv"
}

# _svc_rule <udp|tcp> <port or { set }> <dscp> <comment>
# A service on every device, both directions, IPv4 and IPv6, CS0 only.
_svc_rule() {
    nft add rule inet sqm_dscp "$_chain" ip dscp cs0 $1 dport $2 \
        counter ip dscp set "$3" comment "${4}4"
    nft add rule inet sqm_dscp "$_chain" ip dscp cs0 $1 sport $2 \
        counter ip dscp set "$3" comment "${4}4r"
    nft add rule inet sqm_dscp "$_chain" ip6 dscp cs0 $1 dport $2 \
        counter ip6 dscp set "$3" comment "${4}6"
    nft add rule inet sqm_dscp "$_chain" ip6 dscp cs0 $1 sport $2 \
        counter ip6 dscp set "$3" comment "${4}6r"
}

_build_dscp_rules() {
    local _chain="$1"

    # ------------------------------------------------------------------
    # 1. Priority UDP
    #
    # Each direction is matched on BOTH ports:
    #   - local port  (sport up / dport down) → consoles, fixed local port
    #   - remote port (dport up / sport down) → PC clients, ephemeral local
    #     port, stable server port. Rules suffixed "srv".
    # Same logic applies to Priority TCP below.
    # ------------------------------------------------------------------
    if [ "$PRIORITY_UDP_ENABLE" = "1" ] && [ -n "$PRIORITY_UDP_PORTS" ]; then

        nft add rule inet sqm_dscp "$_chain" \
            ip saddr "$PRIORITY_IP_SET" \
            udp sport { "$PRIORITY_UDP_PORTS" } \
            counter ip dscp set "$PRIORITY_UDP_DSCP" \
            comment "PrioUDPup4"

        nft add rule inet sqm_dscp "$_chain" \
            ip saddr "$PRIORITY_IP_SET" \
            udp dport { "$PRIORITY_UDP_PORTS" } \
            counter ip dscp set "$PRIORITY_UDP_DSCP" \
            comment "PrioUDPup4srv"

        nft add rule inet sqm_dscp "$_chain" \
            ip daddr "$PRIORITY_IP_SET" \
            udp dport { "$PRIORITY_UDP_PORTS" } \
            counter ip dscp set "$PRIORITY_UDP_DSCP" \
            comment "PrioUDPdwn4"

        nft add rule inet sqm_dscp "$_chain" \
            ip daddr "$PRIORITY_IP_SET" \
            udp sport { "$PRIORITY_UDP_PORTS" } \
            counter ip dscp set "$PRIORITY_UDP_DSCP" \
            comment "PrioUDPdwn4srv"

        nft add rule inet sqm_dscp "$_chain" \
            ip6 saddr "$PRIORITY_IP6_SET" \
            udp sport { "$PRIORITY_UDP_PORTS" } \
            counter ip6 dscp set "$PRIORITY_UDP_DSCP" \
            comment "PrioUDPup6"

        nft add rule inet sqm_dscp "$_chain" \
            ip6 saddr "$PRIORITY_IP6_SET" \
            udp dport { "$PRIORITY_UDP_PORTS" } \
            counter ip6 dscp set "$PRIORITY_UDP_DSCP" \
            comment "PrioUDPup6srv"

        nft add rule inet sqm_dscp "$_chain" \
            ip6 daddr "$PRIORITY_IP6_SET" \
            udp dport { "$PRIORITY_UDP_PORTS" } \
            counter ip6 dscp set "$PRIORITY_UDP_DSCP" \
            comment "PrioUDPdwn6"

        nft add rule inet sqm_dscp "$_chain" \
            ip6 daddr "$PRIORITY_IP6_SET" \
            udp sport { "$PRIORITY_UDP_PORTS" } \
            counter ip6 dscp set "$PRIORITY_UDP_DSCP" \
            comment "PrioUDPdwn6srv"
    fi

    # ------------------------------------------------------------------
    # 2. Priority TCP
    # ------------------------------------------------------------------
    if [ "$PRIORITY_TCP_ENABLE" = "1" ] && [ -n "$PRIORITY_TCP_PORTS" ]; then

        nft add rule inet sqm_dscp "$_chain" \
            ip saddr "$PRIORITY_IP_SET" \
            tcp sport { "$PRIORITY_TCP_PORTS" } \
            counter ip dscp set "$PRIORITY_TCP_DSCP" \
            comment "PrioTCPup4"

        nft add rule inet sqm_dscp "$_chain" \
            ip saddr "$PRIORITY_IP_SET" \
            tcp dport { "$PRIORITY_TCP_PORTS" } \
            counter ip dscp set "$PRIORITY_TCP_DSCP" \
            comment "PrioTCPup4srv"

        nft add rule inet sqm_dscp "$_chain" \
            ip daddr "$PRIORITY_IP_SET" \
            tcp dport { "$PRIORITY_TCP_PORTS" } \
            counter ip dscp set "$PRIORITY_TCP_DSCP" \
            comment "PrioTCPdwn4"

        nft add rule inet sqm_dscp "$_chain" \
            ip daddr "$PRIORITY_IP_SET" \
            tcp sport { "$PRIORITY_TCP_PORTS" } \
            counter ip dscp set "$PRIORITY_TCP_DSCP" \
            comment "PrioTCPdwn4srv"

        nft add rule inet sqm_dscp "$_chain" \
            ip6 saddr "$PRIORITY_IP6_SET" \
            tcp sport { "$PRIORITY_TCP_PORTS" } \
            counter ip6 dscp set "$PRIORITY_TCP_DSCP" \
            comment "PrioTCPup6"

        nft add rule inet sqm_dscp "$_chain" \
            ip6 saddr "$PRIORITY_IP6_SET" \
            tcp dport { "$PRIORITY_TCP_PORTS" } \
            counter ip6 dscp set "$PRIORITY_TCP_DSCP" \
            comment "PrioTCPup6srv"

        nft add rule inet sqm_dscp "$_chain" \
            ip6 daddr "$PRIORITY_IP6_SET" \
            tcp dport { "$PRIORITY_TCP_PORTS" } \
            counter ip6 dscp set "$PRIORITY_TCP_DSCP" \
            comment "PrioTCPdwn6"

        nft add rule inet sqm_dscp "$_chain" \
            ip6 daddr "$PRIORITY_IP6_SET" \
            tcp sport { "$PRIORITY_TCP_PORTS" } \
            counter ip6 dscp set "$PRIORITY_TCP_DSCP" \
            comment "PrioTCPdwn6srv"
    fi

    # ------------------------------------------------------------------
    # 2b. Size tiers on priority traffic (optional)
    #
    # Runs after rules 1 and 2, so it only refines what they marked:
    #   UDP: (small, medium] -> PRIORITY_MEDIUM_DSCP, > medium -> BULK_DSCP
    #   TCP: > small -> BULK_DSCP
    # Large packets on a priority port are transfers (updates, downloads
    # inside the application), not real-time traffic.
    # ------------------------------------------------------------------
    if [ "$PRIORITY_SIZE_TIERS" = "1" ]; then
        _mlo=$((PRIORITY_SIZE_SMALL + 1))
        _llo=$((PRIORITY_SIZE_MEDIUM + 1))
        _tlo=$((PRIORITY_SIZE_SMALL + 1))
        if [ "$PRIORITY_UDP_ENABLE" = "1" ] && [ -n "$PRIORITY_UDP_PORTS" ]; then
            _prio_tier ip  "$PRIORITY_IP_SET"  udp "$PRIORITY_UDP_PORTS" "$_mlo-$PRIORITY_SIZE_MEDIUM" "$PRIORITY_MEDIUM_DSCP" TierUDPmed4
            _prio_tier ip  "$PRIORITY_IP_SET"  udp "$PRIORITY_UDP_PORTS" "$_llo-65535" "$BULK_DSCP" TierUDPlarge4
            _prio_tier ip6 "$PRIORITY_IP6_SET" udp "$PRIORITY_UDP_PORTS" "$_mlo-$PRIORITY_SIZE_MEDIUM" "$PRIORITY_MEDIUM_DSCP" TierUDPmed6
            _prio_tier ip6 "$PRIORITY_IP6_SET" udp "$PRIORITY_UDP_PORTS" "$_llo-65535" "$BULK_DSCP" TierUDPlarge6
        fi
        if [ "$PRIORITY_TCP_ENABLE" = "1" ] && [ -n "$PRIORITY_TCP_PORTS" ]; then
            _prio_tier ip  "$PRIORITY_IP_SET"  tcp "$PRIORITY_TCP_PORTS" "$_tlo-65535" "$BULK_DSCP" TierTCPlarge4
            _prio_tier ip6 "$PRIORITY_IP6_SET" tcp "$PRIORITY_TCP_PORTS" "$_tlo-65535" "$BULK_DSCP" TierTCPlarge6
        fi
    fi

    # ------------------------------------------------------------------
    # 2c. Network-wide services (optional, every device)
    # Only marks traffic still at CS0 (same guard as Browsing).
    # ------------------------------------------------------------------
    if [ "$SVC_ICMP_DSCP" != "cs0" ]; then
        nft add rule inet sqm_dscp "$_chain" ip dscp cs0 meta l4proto icmp \
            counter ip dscp set "$SVC_ICMP_DSCP" comment "SvcICMP4"
        nft add rule inet sqm_dscp "$_chain" ip6 dscp cs0 meta l4proto ipv6-icmp \
            counter ip6 dscp set "$SVC_ICMP_DSCP" comment "SvcICMP6"
    fi
    [ "$SVC_DNS" = "1" ] && {
        _svc_rule udp "{ 53, 853, 5353, 123 }" cs3 SvcDNS
        _svc_rule tcp "{ 53, 853 }" cs3 SvcDNStcp
    }
    [ "$SVC_SSH" = "1" ] && _svc_rule tcp "22" af41 SvcSSH
    [ "$SVC_CONFERENCING" = "1" ] && {
        _svc_rule udp "{ 3478-3481, 8801-8810, 9000, 50000-50059 }" af41 SvcConf
        _svc_rule tcp "{ 5004, 5349, 8801-8802 }" af41 SvcConftcp
    }
    [ "$SVC_LIVE_VIDEO" = "1" ] && _svc_rule tcp "{ 1935-1936, 2396, 2935 }" af41 SvcLive
    [ "$SVC_VOIP" = "1" ] && {
        _svc_rule udp "{ 5060-5061, 500, 4500 }" ef SvcVoIP
        _svc_rule tcp "{ 5060-5061 }" ef SvcVoIPtcp
    }

    # ------------------------------------------------------------------
    # 3. Bulk traffic classification
    # ------------------------------------------------------------------
    if [ "$BULK_ENABLE" = "1" ]; then

        if [ -n "$BULK_TCP_PORTS" ]; then
            nft add rule inet sqm_dscp "$_chain" \
                ip saddr "$PRIORITY_IP_SET" \
                tcp dport { "$BULK_TCP_PORTS" } \
                counter ip dscp set "$BULK_DSCP" \
                comment "BulkTCPup4"

            nft add rule inet sqm_dscp "$_chain" \
                ip daddr "$PRIORITY_IP_SET" \
                tcp sport { "$BULK_TCP_PORTS" } \
                counter ip dscp set "$BULK_DSCP" \
                comment "BulkTCPdwn4"

            nft add rule inet sqm_dscp "$_chain" \
                ip6 saddr "$PRIORITY_IP6_SET" \
                tcp dport { "$BULK_TCP_PORTS" } \
                counter ip6 dscp set "$BULK_DSCP" \
                comment "BulkTCPup6"

            nft add rule inet sqm_dscp "$_chain" \
                ip6 daddr "$PRIORITY_IP6_SET" \
                tcp sport { "$BULK_TCP_PORTS" } \
                counter ip6 dscp set "$BULK_DSCP" \
                comment "BulkTCPdwn6"
        fi

        if [ -n "$BULK_UDP_PORTS" ]; then
            nft add rule inet sqm_dscp "$_chain" \
                ip saddr "$PRIORITY_IP_SET" \
                udp dport { "$BULK_UDP_PORTS" } \
                counter ip dscp set "$BULK_DSCP" \
                comment "BulkUDPup4"

            nft add rule inet sqm_dscp "$_chain" \
                ip daddr "$PRIORITY_IP_SET" \
                udp sport { "$BULK_UDP_PORTS" } \
                counter ip dscp set "$BULK_DSCP" \
                comment "BulkUDPdwn4"

            nft add rule inet sqm_dscp "$_chain" \
                ip6 saddr "$PRIORITY_IP6_SET" \
                udp dport { "$BULK_UDP_PORTS" } \
                counter ip6 dscp set "$BULK_DSCP" \
                comment "BulkUDPup6"

            nft add rule inet sqm_dscp "$_chain" \
                ip6 daddr "$PRIORITY_IP6_SET" \
                udp sport { "$BULK_UDP_PORTS" } \
                counter ip6 dscp set "$BULK_DSCP" \
                comment "BulkUDPdwn6"
        fi

        # Smart bulk: large HTTPS packets auto-downgraded (configurable)
        if [ "$BIG_HTTPS_DOWNGRADE" = "1" ]; then
            nft add rule inet sqm_dscp "$_chain" \
                ip saddr "$PRIORITY_IP_SET" \
                ip dscp != "$PRIORITY_UDP_DSCP" \
                meta length gt 1000 tcp dport 443 \
                counter ip dscp set "$BULK_DSCP" \
                comment "BigHTTPSup4"

            nft add rule inet sqm_dscp "$_chain" \
                ip daddr "$PRIORITY_IP_SET" \
                ip dscp != "$PRIORITY_UDP_DSCP" \
                meta length gt 1000 tcp sport 443 \
                counter ip dscp set "$BULK_DSCP" \
                comment "BigHTTPSdwn4"

            nft add rule inet sqm_dscp "$_chain" \
                ip6 saddr "$PRIORITY_IP6_SET" \
                ip6 dscp != "$PRIORITY_UDP_DSCP" \
                meta length gt 1000 tcp dport 443 \
                counter ip6 dscp set "$BULK_DSCP" \
                comment "BigHTTPSup6"

            nft add rule inet sqm_dscp "$_chain" \
                ip6 daddr "$PRIORITY_IP6_SET" \
                ip6 dscp != "$PRIORITY_UDP_DSCP" \
                meta length gt 1000 tcp sport 443 \
                counter ip6 dscp set "$BULK_DSCP" \
                comment "BigHTTPSdwn6"
        fi
    fi

    # ------------------------------------------------------------------
    # 4. Browsing classification
    # Only marks CS0 traffic — does not overwrite existing DSCP marks
    # ------------------------------------------------------------------
    if [ "$BROWSING_ENABLE" = "1" ]; then

        if [ -n "$BROWSING_TCP_PORTS" ]; then
            nft add rule inet sqm_dscp "$_chain" \
                ip dscp cs0 \
                tcp dport { "$BROWSING_TCP_PORTS" } \
                counter ip dscp set "$BROWSING_DSCP" \
                comment "BrowsTCP4"

            nft add rule inet sqm_dscp "$_chain" \
                ip6 dscp cs0 \
                tcp dport { "$BROWSING_TCP_PORTS" } \
                counter ip6 dscp set "$BROWSING_DSCP" \
                comment "BrowsTCP6"
        fi

        if [ -n "$BROWSING_UDP_PORTS" ]; then
            nft add rule inet sqm_dscp "$_chain" \
                ip dscp cs0 \
                udp dport { "$BROWSING_UDP_PORTS" } \
                counter ip dscp set "$BROWSING_DSCP" \
                comment "BrowsUDP4"

            nft add rule inet sqm_dscp "$_chain" \
                ip6 dscp cs0 \
                udp dport { "$BROWSING_UDP_PORTS" } \
                counter ip6 dscp set "$BROWSING_DSCP" \
                comment "BrowsUDP6"
        fi
    fi
}

# =============================================================================
# setup_nftables()
#
# ctinfo ON :
#   postrouting → all DSCP rules + store ctmark
#   prerouting  → empty (tc ctinfo handles restore)
#
# ctinfo OFF :
#   postrouting → store ctmark only
#   prerouting  → all DSCP rules (effective on upload only: download is
#                 redirected to IFB before prerouting runs)
# =============================================================================
setup_nftables() {
    nft delete table inet sqm_dscp >/dev/null 2>&1 || true

    nft -f - << 'NFTEOF'
add table inet sqm_dscp

add chain inet sqm_dscp prerouting {
    type filter hook prerouting priority mangle;
    policy accept;
}

add chain inet sqm_dscp postrouting {
    type filter hook postrouting priority mangle;
    policy accept;
}
NFTEOF

    if [ "$CTINFO_ENABLE" = "1" ]; then
        # ----------------------------------------------------------------
        # ctinfo ON — all rules in postrouting
        # tc ctinfo dscp 63 128 handles DSCP restore on ingress
        # ----------------------------------------------------------------
        _build_dscp_rules "postrouting"

        # Store DSCP into ctmark — read by tc ctinfo on ingress
        nft add rule inet sqm_dscp postrouting \
            oifname "$IFACE" \
            ip protocol != { icmp } \
            ct mark set ip dscp or 0x80 \
            counter comment "StoreIPv4ctmark"

        nft add rule inet sqm_dscp postrouting \
            oifname "$IFACE" \
            ip6 nexthdr != { icmpv6 } \
            ct mark set ip6 dscp or 0x80 \
            counter comment "StoreIPv6ctmark"

        # prerouting intentionally empty

    else
        # ----------------------------------------------------------------
        # ctinfo OFF — rules in prerouting (upload only; download is
        # redirected to IFB before prerouting runs)
        # postrouting only stores ctmark for connection tracking
        # ----------------------------------------------------------------
        _build_dscp_rules "prerouting"

        # Store ctmark in postrouting — tracks connections for future packets
        nft add rule inet sqm_dscp postrouting \
            oifname "$IFACE" \
            ip protocol != { icmp } \
            ct mark set ip dscp or 0x80 \
            counter comment "StoreIPv4ctmark"

        nft add rule inet sqm_dscp postrouting \
            oifname "$IFACE" \
            ip6 nexthdr != { icmpv6 } \
            ct mark set ip6 dscp or 0x80 \
            counter comment "StoreIPv6ctmark"
    fi
}

# =============================================================================
# cleanup_nftables()
# =============================================================================
cleanup_nftables() {
    nft delete table inet sqm_dscp >/dev/null 2>&1 || true
}

# =============================================================================
# SQM lifecycle hooks
# =============================================================================

# Version recorded by install.sh; "unknown" when installed by hand
SLC_VERSION="$(cat /usr/lib/sqm/Seg_Layer_Cake.version 2>/dev/null)"
SLC_VERSION="${SLC_VERSION:-unknown}"

sqm_prepare_script() {
    logger -t SQM "Seg_Layer_Cake.qos v${SLC_VERSION} starting on ${IFACE}"
    _load_uci_options
    do_modules
    if ! verify_qdisc "$QDISC" "cake"; then
        sqm_error "CAKE qdisc unavailable — install kmod-sched-cake (opkg/apk install kmod-sched-cake)"
        return 1
    fi
    setup_nftables
}

sqm_cleanup_script() {
    cleanup_nftables
}

sqm_cleanup() {
    local silent="${1:-0}"
    ipt_log_rewind
    sqm_cleanup_script
    if [ -n "$CUR_IFB" ]; then
        SILENT="$silent" $IP link delete dev "${CUR_IFB}" type ifb 2>/dev/null || true
        sqm_debug "${0}: ${CUR_IFB} interface deleted"
    fi
}

sqm_stop() {
    [ "${DOWNLINK:-0}" -ne 0 ] && \
        $TC qdisc del dev "$IFACE" ingress 2>/dev/null || true
    $TC qdisc del dev "$IFACE" root 2>/dev/null || true
    sqm_cleanup
}
