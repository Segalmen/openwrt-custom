
config queue
	option enabled '1'
	option interface 'eth1'
	option download '100000'
	option upload '20000'
	option qdisc 'cake'
	option script 'Seg_Layer_Cake.qos'
	option qdisc_advanced '1'
	option ingress_ecn 'ECN'
	option egress_ecn 'ECN'
	option qdisc_really_really_advanced '1'
	option itarget 'auto'
	option etarget 'auto'
	option linklayer 'none'
	option debug_logging '0'
	option verbosity '5'
	option squash_dscp '0'
	option squash_ingress '0'
	option iqdisc_opts 'nat diffserv4 dual-dsthost ack-filter memlimit 64mb'
	option eqdisc_opts 'nat diffserv4 dual-srchost ack-filter memlimit 64mb'
	option enable_mq '0'
	option ctinfo_enable '1'
	option priority_udp_enable '0'
	option priority_tcp_enable '0'
	option browsing_enable '0'
	option bulk_enable '0'
	option priority_udp_dscp 'ef'
	option priority_tcp_dscp 'cs0'
	option browsing_tcp_ports '80,8080,443'
	option browsing_udp_ports '443'
	option browsing_dscp 'af21'
	option bulk_dscp 'cs1'
	option bulk_tcp_ports '80,8080'
	option bulk_udp_ports ''
	option big_https_downgrade '1'
	option priority_size_tiers '0'
	option priority_size_small '160'
	option priority_size_medium '1300'
	option priority_medium_dscp 'cs4'
	option svc_icmp_dscp 'cs0'
	option svc_dns '0'
	option svc_ssh '0'
	option svc_conferencing '0'
	option svc_live_video '0'
	option svc_voip '0'
